{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mac Storage Advisor",
  "identifier": "com.mac-storage.mac-storage-advisor",
  "build": {
    "frontendDist": "ui-dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Local inventory of a folder. Nothing is uploaded or permanently deleted.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
